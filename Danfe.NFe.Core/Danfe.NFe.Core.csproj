<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>

    <!-- Identidade do pacote -->
    <PackageId>NFe.Danfe.PdfSharp</PackageId>
    <Version>1.0.0</Version>
    <!-- Nunca abaixo de 2.0.1.0: DLLs já compiladas contra o Danfe.NFe.Core 2.0.1 não carregam versão menor -->
    <AssemblyVersion>2.0.1.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- Metadata -->
    <Authors>Bruno Moreno (bsmoreno2910); Alexandre Laranjeiras (original); SilverCard (DanfeSharp); Flaviano Cardoso Gonçalves Junior (flavsjr)</Authors>
    <Company>Flaviano Cardoso Gonçalves Junior</Company>
    <Copyright>Copyright © 2026 Bruno Moreno; Copyright © 2026 Flaviano Cardoso Gonçalves Junior</Copyright>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <Description>Gerador de DANFE NFe modelo 55 em PDF, sem SixLabors.ImageSharp. Fork do Danfe.NFe.Core 2.0.1 (Bruno Moreno) portado de PdfSharpCore para PDFsharp 6, com os mesmos namespaces e a mesma API pública: substituto direto. Compatível com .NET Standard 2.0, .NET 8 e .NET 10.</Description>
    <PackageTags>danfe;nfe;nota-fiscal-eletronica;pdf;pdfsharp;brasil;fiscal</PackageTags>
    <PackageReleaseNotes>v1.0.0 - Port de PdfSharpCore 1.3.65 para PDFsharp 6.2.4: remove a dependência de SixLabors.ImageSharp (GHSA-j3p4-wp97-rph4, GHSA-j9gm-c75j-xc9q, GHSA-jjfr-hcj7-qf5w, GHSA-gwg2-r3hj-4w44, GHSA-wmxv-xphr-5c9g). Times New Roman do sistema, Liberation Serif do sistema ou Liberation Serif embutida, nessa ordem. API pública do Danfe.NFe.Core 2.0.1 preservada.</PackageReleaseNotes>

    <!-- Links -->
    <PackageProjectUrl>https://github.com/flavsjr/Danfe.NFe.Core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/flavsjr/Danfe.NFe.Core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Licença: código MIT; fonte Liberation Serif embutida sob SIL OFL 1.1 -->
    <PackageLicenseExpression>MIT AND OFL-1.1</PackageLicenseExpression>

    <!-- README embarcado (aparece na página do pacote no nuget.org) -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Build -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Symbols para debug dos consumidores (snupkg = NuGet.org padrão) -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 6.2.4 é a última versão MIT; a 6.5.0 passou para AGPL-3.0 -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- Sobe a transitiva do PDFsharp (8.0.1: GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\LiberationSerif-*.ttf" LogicalName="Danfe.NFe.Core.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Danfe.NFe.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- README do repo é empacotado na raiz do .nupkg -->
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="Fonts\LICENSE-LiberationFonts.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
